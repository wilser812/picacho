DATABASE_URL="postgresql://postgres:postgres@localhost:5432/picacho?schema=public"
JWT_SECRET="change-me-in-production"
# 7d como valor de MVP: todavía no hay refresh tokens implementados, así que un
# expiry corto (ej. 15m) cerraría sesión a los usuarios reales muy seguido.
# Reducir esto cuando se agregue rotación de refresh tokens.
JWT_EXPIRES_IN="7d"
PORT=3001
API_URL="http://localhost:3001"
WEB_URL="http://localhost:3000"
# Dejar vacío para usar el checkout simulado de desarrollo (sin Mercado Pago real).
MP_ACCESS_TOKEN=""
# Dejar vacíos para usar el comprobante simulado de desarrollo (sin OSE real).
# Requiere una cuenta activa en https://www.nubefact.com como emisor electrónico.
NUBEFACT_TOKEN=""
NUBEFACT_RUC=""
